apiVersion: 1

datasources:
  - name: InfluxDB-SmartMfg
    type: influxdb
    access: proxy
    url: http://localhost:8086
    jsonData:
      version: Flux
      organization: smart-manufacturing
      defaultBucket: sensor-data
      tlsSkipVerify: true
    secureJsonData:
      token: TU_INFLUXDB_TOKEN_AQUI
    isDefault: true
    editable: true
